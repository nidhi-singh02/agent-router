{
  "name": "@model-router/router",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "router": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/store/migrations && cp src/store/migrations/*.sql dist/store/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "@model-router/hermes-heartbeat": "*",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
